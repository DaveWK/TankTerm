    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--config-file=[Specify alternative configuration file \[default\: \$XDG_CONFIG_HOME/tankterm/tankterm.toml\]]:CONFIG_FILE:_files' \
'--socket=[Path for IPC socket creation]:SOCKET:_files' \
'--theme=[Theme to use, by built-in name or file path. Overrides the configuration'\''s theme]:NAME|PATH:_default' \
'--working-directory=[Start the shell in the specified working directory]:WORKING_DIRECTORY:_files' \
'*-e+[Command and args to execute (must be last argument)]:COMMAND:_default' \
'*--command=[Command and args to execute (must be last argument)]:COMMAND:_default' \
'-T+[Defines the window title \[default\: TankTerm\]]:TITLE:_default' \
'--title=[Defines the window title \[default\: TankTerm\]]:TITLE:_default' \
'--class=[Defines window class/app_id on X11/Wayland \[default\: TankTerm\]]:general> | <general>,<instance:_default' \
'*-o+[Override configuration file options \[example\: '\''cursor.style="Beam"'\''\]]:OPTION:_default' \
'*--option=[Override configuration file options \[example\: '\''cursor.style="Beam"'\''\]]:OPTION:_default' \
'(-v)*-q[Reduces the level of verbosity (the min level is -qq)]' \
'(-q)*-v[Increases the level of verbosity (the max level is -vvv)]' \
'--daemon[Do not spawn an initial window]' \
'--hold[Remain open after child process exit]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_tankTerm_commands" \
"*::: :->tankTerm" \
&& ret=0
    case $state in
    (tankTerm)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:tankTerm-command-$line[1]:"
        case $line[1] in
            (msg)
_arguments "${_arguments_options[@]}" : \
'-s+[IPC socket connection path override]:SOCKET:_files' \
'--socket=[IPC socket connection path override]:SOCKET:_files' \
'-h[Print help]' \
'--help[Print help]' \
":: :_tankTerm__subcmd__msg_commands" \
"*::: :->msg" \
&& ret=0

    case $state in
    (msg)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:tankTerm-msg-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
'--format=[How to print the panes]:FORMAT:((table\:"A table, one pane per line"
json\:""))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(spawn)
_arguments "${_arguments_options[@]}" : \
'()--profile=[Open the tab from this profile]:PROFILE:_default' \
'--cwd=[Start the program in this directory \[default\: as for a new tab or pane\]]:CWD:_files -/' \
'-h[Print help]' \
'--help[Print help]' \
'*::command -- Program and arguments to run \[default\: the shell\]:_default' \
&& ret=0
;;
(split-pane)
_arguments "${_arguments_options[@]}" : \
'--pane-id=[Pane to split \[default\: \$TANKTERM_PANE_ID, or the focused pane\]]:PANE_ID:_default' \
'--percent=[Share of the space the new pane gets, in percent \[default\: 50\]]:PERCENT:_default' \
'--cwd=[Start the program in this directory \[default\: as for a new tab or pane\]]:CWD:_files -/' \
'(--left --right --top --bottom)--horizontal[The same as \`--right\`]' \
'(--right --top --bottom)--left[Put the new pane left of the pane]' \
'(--top --bottom)--right[Put the new pane right of the pane]' \
'(--bottom)--top[Put the new pane above the pane]' \
'--bottom[Put the new pane below the pane (the default)]' \
'-h[Print help]' \
'--help[Print help]' \
'*::command -- Program and arguments to run \[default\: the shell\]:_default' \
&& ret=0
;;
(send-text)
_arguments "${_arguments_options[@]}" : \
'--pane-id=[Pane to send the text to \[default\: \$TANKTERM_PANE_ID, or the focused pane\]]:PANE_ID:_default' \
'--no-paste[Send the text as it is, instead of pasting it]' \
'-h[Print help]' \
'--help[Print help]' \
'::text -- Text to send \[default\: read from standard input\]:_default' \
&& ret=0
;;
(get-text)
_arguments "${_arguments_options[@]}" : \
'--pane-id=[Pane to read \[default\: \$TANKTERM_PANE_ID, or the focused pane\]]:PANE_ID:_default' \
'--start-line=[First line to print\: 0 is the top of the screen, negative lines are scrollback \[default\: 0\]]:START_LINE:_default' \
'--end-line=[Last line to print \[default\: the bottom of the screen\]]:END_LINE:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(activate-pane)
_arguments "${_arguments_options[@]}" : \
'--pane-id=[The pane \[default\: \$TANKTERM_PANE_ID, or the focused pane\]]:PANE_ID:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(activate-tab)
_arguments "${_arguments_options[@]}" : \
'(--tab-index --tab-relative)--tab-id=[The tab with this ID]:TAB_ID:_default' \
'(--tab-relative)--tab-index=[The tab at this position, counting from 0; negative positions count from the last tab, which is -1]:TAB_INDEX:_default' \
'--tab-relative=[The tab this many tabs right of the shown one, or left of it for negative numbers, wrapping around at the ends]:TAB_RELATIVE:_default' \
'(--tab-id --tab-index)--no-wrap[Stop at the first or last tab instead of wrapping around]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(kill-pane)
_arguments "${_arguments_options[@]}" : \
'--pane-id=[The pane \[default\: \$TANKTERM_PANE_ID, or the focused pane\]]:PANE_ID:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(zoom-pane)
_arguments "${_arguments_options[@]}" : \
'--pane-id=[The pane \[default\: \$TANKTERM_PANE_ID, or the focused pane\]]:PANE_ID:_default' \
'(--unzoom --toggle)--zoom[Zoom the pane (the default)]' \
'(--toggle)--unzoom[Unzoom the pane'\''s tab]' \
'--toggle[Zoom the pane, or unzoom its tab if it is zoomed]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(set-tab-title)
_arguments "${_arguments_options[@]}" : \
'--pane-id=[A pane of the tab \[default\: \$TANKTERM_PANE_ID, or the focused pane\]]:PANE_ID:_default' \
'--tab-id=[The tab with this ID, in place of a pane'\''s tab]:TAB_ID:_default' \
'-h[Print help]' \
'--help[Print help]' \
