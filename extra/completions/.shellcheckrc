# tankTerm.bash is generated by clap_complete, and a test checks that it matches
# the generator's output exactly, so it can't be edited by hand.
#
# SC2207 flags `COMPREPLY=($(compgen ...))`, which splits the matches on
# whitespace. The generated code sets IFS to a newline first for options that
# take paths (--config-file, --working-directory); the rest complete words
# without spaces.
disable=SC2207
